# Local Phase 2/3/4 fixture environment. Never enable fixtures on a deployed host.
# Feature release switch: defaults to false when absent. No remote runner is enabled.
ALGOHUB_PRACTICUM_ENABLED=true
ALGOHUB_ELEARNING_ENABLED=true
ALGOHUB_SIAKAD_ENABLED=true
# API only: optional separate random 32+ character cron secret. Empty disables cron.
ALGOHUB_PRACTICUM_CRON_SECRET=
NODE_ENV=development
ALGOHUB_ENV=local
ALGOHUB_ENABLE_FIXTURES=true
ALGOHUB_ADDR=127.0.0.1:8080
ALGOHUB_API_BASE_URL=http://127.0.0.1:8080
ALGOHUB_AUTH_ORIGIN=http://auth.localhost:5174
ALGOHUB_ALLOWED_ORIGINS=http://portal.localhost:5173,http://auth.localhost:5174,http://admin.localhost:5175,http://siakad.localhost:5176,http://elearning.localhost:5177,http://praktikum.localhost:5178
ALGOHUB_SSO_ALLOWED_ORIGINS=http://portal.localhost:5173,http://auth.localhost:5174,http://admin.localhost:5175,http://siakad.localhost:5176,http://elearning.localhost:5177,http://praktikum.localhost:5178
ALGOHUB_COOKIE_SECURE=false
ALGOHUB_REQUEST_TIMEOUT=25s
ALGOHUB_SESSION_TTL=12h
ALGOHUB_AUTH_RATE_LIMIT=120
ALGOHUB_USER_RATE_LIMIT=600
ALGOHUB_OPENAPI_PATH=docs/openapi/openapi.yaml
# Optional non-authoritative browser-preview fallback. Empty token keeps
# POST /v1/playground/run disabled with 503; never commit a real token.
ALGOHUB_PLAYGROUND_GLOT_URL=https://glot.io/api/mux
ALGOHUB_PLAYGROUND_GLOT_TOKEN=

# API only: disable fixtures and configure the fresh staging Supabase project.
# Keep actual database credentials in the API environment, never in PUBLIC_*.
ALGOHUB_DATABASE_URL=
ALGOHUB_DB_MAX_CONNS=4
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Auth Center server only: optional configured Supabase OAuth provider.
SUPABASE_SSO_PROVIDER=

# Tests only: isolated loopback database; its name must end in _test.
ALGOHUB_TEST_DATABASE_URL=

# Optional local MCP credential, unrelated to the application runtime.
API_KEY_21ST=
