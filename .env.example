# ====== Backend Environment ======
# Salin file ini menjadi backend/.env (atau set sebagai env OS)

# Server
APP_PORT=8080
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://elearning.algohub.web.id,https://algohub.web.id

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=lab_ap
DB_PARAMS=sslmode=disable TimeZone=Asia/Jakarta

# JWT
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_EXPIRE_HOURS=12

# Auth Supabase (RS256) — adopsi project_mikon
# legacy = HS256 lokal saja, dual = Supabase RS256 atau HS256 (transisi), supabase = hanya RS256
# Kosongkan Supabase var = operasi lokal fallback (fallback file .env prod ada SERVICE_KEY).
AUTH_MODE=legacy
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=authenticated
ALLOW_ITPLN_DOMAIN=false

# Online registry (server stateful) - TTL entri online dalam detik
ONLINE_TTL_SECONDS=120

# Background auto-submit sweeper - interval dalam detik
SWEEPER_INTERVAL_SECONDS=30

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key
SUPABASE_BUCKET=public-assets

# AI grading — endpoint OpenAI-compatible /v1/chat/completions
OLLAMA_URL=https://router.bynara.id/v1/chat/completions
OLLAMA_MODEL=mimo-v2.5-pro-hermes
OLLAMA_API_KEY=

# ====== Frontend (.env di folder frontend) ======
# PUBLIC_API_BASE_URL=http://localhost:8080
# PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=anon-key
