{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "21st": {
        "type": "remote",
        "url": "https://21st.dev/api/mcp",
        "oauth": false,
        "headers": {
          "x-api-key": "{env:API_KEY_21ST}"
        }
      },
      "framer": {
        "type": "remote",
        "url": "https://mcp.framer.com/mcp"
      }
    }
  }
}
